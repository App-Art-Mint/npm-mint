{
	"name": "@appartmint/mint",
	"author": "App Art Mint LLC",
	"version": "5.0.14",
	"type": "module",
	"license": "MIT",
	"description": "The front-end TS/SCSS framework of App Art Mint",
	"keywords": [
		"appartmint",
		"app-art-mint",
		"framework",
		"frontend",
		"mint"
	],
	"homepage": "https://github.com/App-Art-Mint/npm-mint#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/App-Art-Mint/npm-mint.git"
	},
	"bugs": {
		"url": "https://github.com/App-Art-Mint/npm-mint/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/**/*.scss",
		"dist/**/*.{css,js,d.ts,map}"
	],
	"main": "dist/index.esm.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.esm.js",
			"require": "./dist/index.cjs.js",
			"default": "./dist/index.esm.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.esm.js",
			"require": "./dist/*.cjs.js",
			"default": "./dist/*.esm.js"
		},
		"./css/*": "./dist/*.css",
		"./scss/*": "./src/scss/_*.scss",
		"./scss/*/": "./src/scss/*/_index.scss",
		"./scss/entry/*": "./src/scss/*.scss"
	},
	"scripts": {
		"version": "npm i --package-lock-only && git add -A",
		"postversion": "git push && git push --tags && cross-replace gh release create \"v$npm_package_version\" --generate-notes",
		"prepare": "run-s clean lint test build",
		"clean": "rimraf dist docs",
		"build": "run-s build:**",
		"build:prod": "vite build",
		"build:css:dev": "sass src/scss/mint.scss dist/mint.css && sass src/scss/noscript.scss dist/noscript.css",
		"build:css:prod": "sass src/scss/mint.scss dist/mint.min.css --style compressed && sass src/scss/noscript.scss dist/noscript.min.css --style compressed",
		"build:tsdoc": "typedoc --tsconfig tsconfig.lib.json",
		"test": "run-p test:**",
		"test:types": "tsc -b",
		"test:deps": "depcruise src",
		"lint": "eslint --fix .",
		"format": "run-s format:**",
		"format:imports": "npm run format:imports --prefix ./node_modules/@appartmint/tsm-scripts",
		"yalc:publish": "yalc publish",
		"check:updates": "npm-check-updates"
	},
	"devDependencies": {
		"@appartmint/tsm-scripts": "^0.4.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"cross-replace": "^0.2.0",
		"dependency-cruiser": "^18.1.0",
		"eslint": "^10.7.0",
		"glob": "^13.0.6",
		"globals": "^17.7.0",
		"jiti": "^2.7.0",
		"npm-check-updates": "^22.2.9",
		"npm-run-all2": "^9.0.2",
		"rimraf": "^6.1.3",
		"sass": "^1.101.7",
		"tsx": "^4.23.1",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vite-plugin-dts": "^5.0.3",
		"yalc": "^1.0.0-pre.53"
	}
}
